# Binance Futures testnet keys only. Never put mainnet keys here.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# Start with one symbol until the loop is stable.
TRADING_SYMBOLS=ETHUSDC

# Runtime isolation.
DB_PATH=testnet/data/gridbot_testnet.db
LOG_LEVEL=INFO

# Existing monitor settings.
FETCH_INTERVAL_MINUTES=30
ACTIVE_STRATEGY_NAME=testnet
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Prefer a separate bot/chat or make every message clearly testnet-labeled later.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Forward-looking execution guard for the testnet trader work.
# Use signal_only for monitoring, testnet_live for strategy-driven auto orders.
TRADING_MODE=signal_only
TESTNET_STRATEGY_LABEL=router_allocator_v13_trend350
TESTNET_EQUITY_USDC=150
TESTNET_DAILY_TARGET_PCT=2.7
TESTNET_AUTO_TRADE_INTERVAL_MINUTES=5
TESTNET_KLINE_INTERVAL=5m
TESTNET_KLINE_LIMIT=300
TESTNET_MIN_SIGNAL_SCORE=58
TESTNET_MAX_POSITION_MARGIN_PCT=35
MAX_EFFECTIVE_LEVERAGE=70
MAX_DAILY_LOSS_PCT=36
DAILY_SOFT_LOSS_PCT=16
MAX_TRADE_RISK_PCT=100
TREND_AGGRESSIVE_SCALE=3.5
TESTNET_MAX_ORDER_NOTIONAL_USDC=150
