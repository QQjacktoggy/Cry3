+def _ai_risk_candidate_payload(
+    strategy: str,
+    signal: SignalPlan,
+    allocator_state: str,
+    allocator_profile: str,
+    allocator_scale: float,
+    runtime_base: StrategyConfig,
+    day_pnl: float,
+) -> dict:
